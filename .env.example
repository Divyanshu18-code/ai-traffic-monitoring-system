# Application Configuration
APP_ENV=development
APP_DEBUG=False
APP_HOST=0.0.0.0
APP_PORT=8501

# YOLO Model Configuration
DEFAULT_MODEL_NAME=yolov8n.pt
MODELS_DIR=models
CONFIDENCE_THRESHOLD=0.35
IOU_THRESHOLD=0.45
IMG_SIZE=640
DEVICE=cpu

# Database Configuration
DATABASE_PATH=data/traffic_analytics.db

# Processing Configuration
FRAME_SKIP=0
MAX_UPLOAD_SIZE_MB=200
ALLOWED_EXTENSIONS=mp4,avi,mov,mkv

# Traffic Counting Configuration
DEFAULT_LINE_POSITION_RATIO=0.60
CONGESTION_LOW_THRESHOLD=5
CONGESTION_MODERATE_THRESHOLD=15

# Logging Configuration
LOG_LEVEL=INFO
LOG_FILE=logs/traffic_system.log
